theme_override_fonts/font = ExtResource("2_6yaub")
theme_override_font_sizes/font_size = 24
text = "O massacre em Vila Nova dos Campos serviu como um alerta para a crescente onda de violência e instabilidade causada pela nova droga. Cidadãos da região estão em choque, e vigílias estão sendo organizadas em memória das vítimas, que incluem desde trabalhadores locais até crianças que estavam próximas ao local do ataque."
autowrap_mode = 3
uppercase = true

