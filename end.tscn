theme_override_fonts/font = ExtResource("2_6yaub")
theme_override_font_sizes/font_size = 24
text = "A pacata cidade de Vila Nova dos Campos, situada no interior do estado de Minas Gerais, foi abalada por uma tragédia sem precedentes na tarde desta segunda-feira. Um jovem de apenas 17 anos, identificado como Lucas Nogueira, foi responsável por um massacre que deixou inúmeras mortes e vítimas gravemente feridas. Segundo a perícia, o adolescente estava sob os efeitos de uma droga altamente perigosa e crescente no mercado ilícito, chamada Avaj."
autowrap_mode = 3
uppercase = true

[node name="P2" type="Label" parent="ColorRect"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -496.0
offset_top = -86.0
offset_right = 496.0
offset_bottom = 87.0
grow_horizontal = 2
grow_vertical = 2
theme_override_fonts/font = ExtResource("2_6yaub")
theme_override_font_sizes/font_size = 24
text = "Durante o ataque, moradores tentaram desesperadamente deter Lucas, mas a brutalidade da situação escalou rapidamente. Entre os feridos estão um policial, único sobrevivente do ocorrido, tentaram negociar com o jovem e conter a situação, sem sucesso. \"Nós gritávamos para ele parar, mas ele não nos ouvia. Não era mais o Lucas que conhecíamos\", relatou Antônio Mendes, O policial que sobreviveu ao ocorrido."
autowrap_mode = 3
uppercase = true

[node name="P3" type="Label" parent="ColorRect"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -496.0
offset_top = -86.5
offset_right = 496.0
offset_bottom = 86.5
grow_horizontal = 2
grow_vertical = 2
theme_override_fonts/font = ExtResource("2_6yaub")
theme_override_font_sizes/font_size = 24
text = "A polícia foi chamada imediatamente, mas ao chegarem ao local, as forças de segurança se depararam com uma cena devastadora. Lucas, após causar o massacre, tirou a própria vida com um disparo na cabeça, antes que qualquer negociação ou contenção fosse possível."
autowrap_mode = 3
uppercase = true

[node name="P4" type="Label" parent="ColorRect"]
